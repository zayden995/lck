---
import { tiers, currency } from '../data/products.js';
import { whatsappLink } from '../data/site.js';

const isPlaceholder = (s) => s.includes('[PLACEHOLDER');
---

<section class="section products" id="products">
  <div class="wrap">
    <div class="head reveal">
      <p class="eyebrow">Products and pricing</p>
      <h2>Pick your stand.</h2>
      <p class="lead">Prices are in Singapore dollars. <span class="ph">[PLACEHOLDER: what is included, delivery]</span></p>
    </div>

    <div class="cards">
      {tiers.map((t) => {
        const msg = t.price
          ? `Hi LCK Tech, I would like to order ${t.label} (${currency}${t.price}).`
          : 'Hi LCK Tech, I would like a custom QR stand. Here is what I have in mind:';
        const href = whatsappLink(msg);
        return (
          <article class:list={['card', 'reveal', { custom: !t.price }]}>
            <div class="photo" role="img" aria-label={`${t.label} photo placeholder`}>
              <span class="ph">[PLACEHOLDER: photo]</span>
            </div>
            <p class="tier">{t.label}</p>
            <h3 class:list={{ ph: isPlaceholder(t.name) }}>{t.name}</h3>
            <p class="price">
              {t.price ? (<><span class="cur">{currency}</span>{t.price}</>) : (<span class="note">{t.priceNote}</span>)}
            </p>
            <p class:list={['blurb', { ph: isPlaceholder(t.blurb) }]}>{t.blurb}</p>
            <ul>
              {t.features.map((f) => <li class:list={{ ph: isPlaceholder(f) }}>{f}</li>)}
            </ul>
            <a class="pill pill-light" href={href} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener">
              {t.price ? 'Order on WhatsApp' : 'Ask about custom'} <span class="ar" aria-hidden="true">&#8599;</span>
            </a>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .head { margin-bottom: clamp(36px, 5vw, 64px); }
  .head .lead { margin-top: 18px; }
  .cards { display: grid; grid-template-columns: 1fr; gap: 18px; }
  @media (min-width: 640px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .cards { grid-template-columns: repeat(4, 1fr); } }

  .card {
    display: flex;
    flex-direction: column;
    padding: 18px;
    border-radius: var(--radius);
    background: var(--soft-ghost);
    border: 1px solid var(--soft-faint);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .card:hover { transform: translateY(-4px); border-color: rgba(255, 77, 20, 0.6); }
  .card.custom { background: linear-gradient(160deg, rgba(255, 77, 20, 0.22), var(--soft-ghost) 60%); border-color: rgba(255, 77, 20, 0.5); }

  .photo {
    aspect-ratio: 4 / 5;
    border-radius: 12px;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 12px;
    font-size: 12px;
    background: radial-gradient(80% 70% at 50% 35%, var(--flame-tint), transparent 70%), var(--jet);
    border: 1px dashed var(--soft-faint);
  }
  .tier { margin: 18px 0 2px; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--flame); font-weight: 600; }
  h3 { margin: 0; font-size: 17px; font-weight: 500; line-height: 1.3; }
  .price { margin: 14px 0 12px; font-size: clamp(40px, 4vw, 52px); font-weight: 500; line-height: 1; letter-spacing: -0.02em; }
  .price .cur { font-size: 0.45em; margin-right: 4px; vertical-align: 0.9em; letter-spacing: 0; color: var(--soft-dim); }
  .price .note { font-size: 22px; letter-spacing: -0.01em; line-height: 1.2; display: inline-block; padding-block: 8px; }
  .blurb { margin: 0 0 14px; color: var(--soft-dim); font-size: 13px; }
  ul { list-style: none; margin: 0 0 22px; padding: 0; display: grid; gap: 8px; font-size: 13px; flex: 1; align-content: start; }
  li { padding-top: 8px; border-top: 1px solid var(--soft-faint); }
  .pill { align-self: flex-start; }
</style>
