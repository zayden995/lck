---
import { tiers, currency } from '../data/products.js';
import { site } from '../data/site.js';

const from = Math.min(...tiers.filter((t) => t.price).map((t) => t.price));
const facts = [
  { value: `${currency}${from}`, label: 'starting price' },
  { value: `${tiers.length}`, label: 'stand designs, custom included' },
  { value: site.turnaroundShort, label: 'from order to ready' },
];
---

<section class="section about" id="about">
  <div class="wrap grid">
    <div class="reveal">
      <p class="eyebrow">About LCK Tech</p>
      <h2>Built for<br />the counter.</h2>
    </div>
    <div class="reveal">
      <p class="lead">
        LCK Tech makes PayNow QR stands for hawker stalls and small shops. Every stand is 3D printed with your QR code, from a simple plate to a waving lucky cat, and made to stay upright through a busy day.
      </p>
      <ul class="facts">
        {facts.map((f) => (
          <li>
            <b class={f.placeholder ? 'ph' : ''}>{f.value}</b>
            <span class={f.placeholder ? 'ph' : ''}>{f.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1fr; gap: 40px; align-items: start; }
  @media (min-width: 900px) { .grid { grid-template-columns: 1fr 1.1fr; gap: 80px; } }
  .facts { list-style: none; margin: 44px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .facts li { border-top: 1px solid var(--soft-faint); padding-top: 18px; }
  .facts b { display: block; font-size: clamp(22px, 3vw, 36px); font-weight: 500; letter-spacing: -0.01em; line-height: 1.1; }
  .facts span { display: block; margin-top: 8px; font-size: 12px; color: var(--soft-dim); }
  .facts .ph { font-size: 12px; }
  .facts b.ph { font-size: clamp(14px, 1.6vw, 18px); }
  @media (max-width: 560px) { .facts { grid-template-columns: 1fr; } }
</style>
