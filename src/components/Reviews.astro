---
import { reviews } from '../data/reviews.js';

const stars = (n) => '★'.repeat(n) + '☆'.repeat(5 - n);
---

<section class="section reviews" id="reviews">
  <div class="wrap">
    <div class="head reveal">
      <p class="eyebrow">Reviews</p>
      <h2>What stall owners say.</h2>
    </div>
    <div class="grid">
      {reviews.map((r) => (
        <figure class="review reveal">
          <div class="stars" role="img" aria-label={`${r.stars} out of 5 stars`}>{stars(r.stars)}</div>
          <blockquote>{r.quote}</blockquote>
          <figcaption><b>{r.name}</b><span>{r.role}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .head { margin-bottom: clamp(36px, 5vw, 64px); }
  .grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
  @media (min-width: 700px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  .review {
    margin: 0;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--soft-ghost);
    border: 1px solid var(--soft-faint);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .stars { color: var(--flame); letter-spacing: 0.18em; font-size: 15px; }
  blockquote { margin: 0; font-size: 17px; line-height: 1.5; flex: 1; }
  figcaption { display: grid; gap: 2px; font-size: 13px; }
  figcaption b { font-weight: 600; }
  figcaption span { color: var(--soft-dim); }
</style>
