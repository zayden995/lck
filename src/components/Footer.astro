---
import { site } from '../data/site.js';
---

<footer class="foot">
  <div class="wrap row">
    <div>
      <p class="brand">LCK TECH</p>
      <p class="tag">{site.tagline}</p>
    </div>
    <p class="meta">UEN {site.uen} &nbsp;·&nbsp; {site.web}</p>
    <p class="meta">&copy; 2026 {site.name}</p>
  </div>
</footer>

<style>
  .foot { border-top: 1px solid var(--soft-faint); padding-block: 40px 56px; }
  .row { display: flex; flex-wrap: wrap; gap: 20px 48px; justify-content: space-between; align-items: flex-end; }
  .brand { margin: 0; font-weight: 700; letter-spacing: 0.22em; font-size: 15px; }
  .tag { margin: 4px 0 0; font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--soft-dim); }
  .meta { margin: 0; font-size: 12px; color: var(--soft-dim); }
</style>
