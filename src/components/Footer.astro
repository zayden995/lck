---
import { site, whatsappLink, whatsappReady, isPlaceholder } from '../data/site.js';

const wa = whatsappLink('Hi LCK Tech, I would like to ask about your QR stands.');
const year = new Date().getFullYear();
const links = [
  { href: '#products', label: 'Products' },
  { href: '#order', label: 'How to order' },
  { href: '#reviews', label: 'Reviews' },
  { href: '#contact', label: 'Contact' },
];
---

<footer class="foot">
  <div class="wrap row">
    <div class="brandcol">
      <a class="brand" href="#top">LCK TECH</a>
      <p class="tag">{site.tagline}</p>
    </div>
    <nav class="col" aria-label="Footer">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="col">
      {whatsappReady() && <a href={wa} target="_blank" rel="noopener">WhatsApp {site.whatsappDisplay}</a>}
      {!isPlaceholder(site.email) && <a href={`mailto:${site.email}`}>{site.email}</a>}
    </div>
  </div>
  <div class="wrap legal">
    <p>Based in {site.location} &nbsp;·&nbsp; UEN {site.uen} &nbsp;·&nbsp; {site.web}</p>
    <p>&copy; {year} {site.name}</p>
  </div>
</footer>

<style>
  .foot { position: relative; z-index: 2; border-top: 1px solid var(--soft-faint); padding-block: 48px 40px; }
  .row { display: grid; grid-template-columns: 1fr; gap: 28px; }
  @media (min-width: 700px) { .row { grid-template-columns: 1.4fr 1fr 1.2fr; gap: 40px; } }
  .brand { display: inline-block; font-weight: 700; letter-spacing: 0.22em; font-size: 15px; text-decoration: none; }
  .tag { margin: 4px 0 0; font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--soft-dim); }
  .col { display: grid; gap: 8px; align-content: start; font-size: 13px; }
  .col a { color: var(--soft-dim); text-decoration: none; width: fit-content; transition: color 0.2s ease; }
  .col a:hover { color: var(--flame); }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--soft-faint); }
  .legal p { margin: 0; font-size: 12px; color: var(--soft-dim); }
</style>
