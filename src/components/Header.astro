---
import { site, whatsappLink } from '../data/site.js';

// Desktop shows these split around the logo (the logo itself goes back to the top).
// The phone menu shows Home first, then the same list.
const links = [
  { href: '#about', label: 'About' },
  { href: '#products', label: 'Products' },
  { href: '#order', label: 'How to order' },
  { href: '#reviews', label: 'Reviews' },
  { href: '#contact', label: 'Contact' },
];
const wa = whatsappLink('Hi LCK Tech, I would like to ask about your QR stands.');
const ext = wa.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};
---

<header class="site-header" id="site-header">
  <div class="bar">
    <nav class="links links-l" aria-label="Main">
      {links.slice(0, 3).map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="brand" href="#top" aria-label={`${site.name}, back to top`}>
      LCK TECH<small>{site.tagline.toUpperCase()}</small>
    </a>
    <nav class="links links-r" aria-label="More">
      {links.slice(3).map((l) => <a href={l.href}>{l.label}</a>)}
      <a class="wa" href={wa} {...ext}>WhatsApp <span aria-hidden="true">&#8599;</span></a>
    </nav>
    <div class="small-actions">
      <a class="wa wa-small" href={wa} {...ext}>WhatsApp <span aria-hidden="true">&#8599;</span></a>
      <button class="menu-btn" type="button" id="menu-btn" aria-expanded="false" aria-controls="mobile-menu">Menu</button>
    </div>
  </div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile" hidden>
    <a href="#top">Home</a>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    transition: background 0.3s ease, backdrop-filter 0.3s ease;
  }
  .site-header.scrolled {
    background: rgba(11, 11, 12, 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--soft-faint);
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 30px max(26px, env(safe-area-inset-right, 0px)) 30px max(26px, env(safe-area-inset-left, 0px));
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: padding 0.3s ease;
  }
  .scrolled .bar { padding-block: 22px; }
  .links { display: flex; gap: 30px; align-items: center; }
  .links-r { justify-content: flex-end; }
  .links a { color: var(--soft); text-decoration: none; opacity: 0.86; transition: opacity 0.2s; }
  .links a:hover { opacity: 1; }
  .brand {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.22em;
    line-height: 1.05;
    text-align: center;
    color: var(--soft);
    text-decoration: none;
    white-space: nowrap;
  }
  .brand small { display: block; margin-top: 2px; font-size: 8.5px; letter-spacing: 0.34em; font-weight: 500; opacity: 0.8; }
  .wa {
    background: var(--flame);
    color: var(--jet) !important;
    opacity: 1 !important;
    padding: 11px 18px;
    border-radius: 999px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .small-actions { display: none; justify-self: end; align-items: center; gap: 8px; }
  .wa-small { text-decoration: none; font-size: 11px; text-transform: uppercase; white-space: nowrap; }
  .menu-btn {
    min-width: 82px; /* same width for "Menu" and "Close", so the bar does not shift */
    white-space: nowrap;
    background: var(--soft-ghost);
    border: 1px solid var(--soft-faint);
    color: var(--soft);
    border-radius: 999px;
    padding: 9px 16px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .mobile-menu {
    display: grid;
    gap: 2px;
    padding: 8px max(26px, env(safe-area-inset-left, 0px)) 22px;
    background: rgba(11, 11, 12, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--soft-faint);
  }
  .mobile-menu a { padding: 12px 0; text-decoration: none; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; border-bottom: 1px solid var(--soft-faint); }
  .mobile-menu a:last-child { border-bottom: 0; }

  /* Below 1000px the six nav items no longer fit beside the logo, so they move into the menu. */
  @media (max-width: 999px) {
    .bar { grid-template-columns: 1fr auto; padding-block: 22px; }
    .scrolled .bar { padding-block: 16px; }
    .links { display: none; }
    .brand { text-align: left; }
    .small-actions { display: flex; }
  }
  /* On phones the WhatsApp and Menu buttons take the room the tagline needs. */
  @media (max-width: 520px) {
    .brand small { display: none; }
  }
  @media (max-width: 400px) {
    .bar { padding-inline: max(16px, env(safe-area-inset-left, 0px)); gap: 10px; }
    .wa-small, .menu-btn { padding-inline: 13px; }
    .menu-btn { min-width: 74px; }
    .brand { font-size: 15px; }
  }
  @media (max-width: 340px) {
    .wa-small span { display: none; }
    .brand { letter-spacing: 0.14em; }
  }
  @media (min-width: 1000px) { .mobile-menu { display: none; } }
</style>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');

  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  function setOpen(open) {
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'Close' : 'Menu';
    menu.hidden = !open;
    if (open) header?.classList.add('scrolled');
    else onScroll();
  }
  btn?.addEventListener('click', () => setOpen(menu?.hidden ?? true));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
