---
import { site, whatsappLink } from '../data/site.js';

const links = [
  { href: '#top', label: 'Home' },
  { href: '#about', label: 'About' },
  { href: '#products', label: 'Products' },
  { href: '#reviews', label: 'Reviews' },
  { href: '#contact', label: 'Contact' },
];
const wa = whatsappLink('Hi LCK Tech, I would like to ask about your QR stands.');
---

<header class="site-header" id="site-header">
  <div class="bar">
    <nav class="links links-l" aria-label="Main">
      {links.slice(0, 3).map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="brand" href="#top" aria-label={`${site.name}, back to top`}>
      LCK TECH<small>{site.tagline.toUpperCase()}</small>
    </a>
    <nav class="links links-r" aria-label="More">
      {links.slice(3).map((l) => <a href={l.href}>{l.label}</a>)}
      <a class="wa" href={wa} target={wa.startsWith('http') ? '_blank' : undefined} rel="noopener">WhatsApp <span aria-hidden="true">&#8599;</span></a>
    </nav>
    <button class="menu-btn" type="button" id="menu-btn" aria-expanded="false" aria-controls="mobile-menu">Menu</button>
  </div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile" hidden>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a class="wa" href={wa} target={wa.startsWith('http') ? '_blank' : undefined} rel="noopener">WhatsApp us</a>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    transition: background 0.3s ease, backdrop-filter 0.3s ease;
  }
  .site-header.scrolled {
    background: rgba(11, 11, 12, 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--soft-faint);
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 24px max(26px, env(safe-area-inset-right, 0px)) 24px max(26px, env(safe-area-inset-left, 0px));
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: padding 0.3s ease;
  }
  .scrolled .bar { padding-block: 14px; }
  .links { display: flex; gap: 30px; align-items: center; }
  .links-r { justify-content: flex-end; }
  .links a { color: var(--soft); text-decoration: none; opacity: 0.86; transition: opacity 0.2s; }
  .links a:hover { opacity: 1; }
  .brand {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.22em;
    line-height: 1.05;
    text-align: center;
    color: var(--soft);
    text-decoration: none;
  }
  .brand small { display: block; font-size: 8px; letter-spacing: 0.34em; font-weight: 500; opacity: 0.8; }
  .wa {
    background: var(--flame);
    color: var(--jet) !important;
    opacity: 1 !important;
    padding: 9px 16px;
    border-radius: 999px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .menu-btn {
    display: none;
    justify-self: end;
    background: var(--soft-ghost);
    border: 1px solid var(--soft-faint);
    color: var(--soft);
    border-radius: 999px;
    padding: 9px 16px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .mobile-menu {
    display: grid;
    gap: 2px;
    padding: 8px max(26px, env(safe-area-inset-left, 0px)) 22px;
    background: rgba(11, 11, 12, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--soft-faint);
  }
  .mobile-menu a { padding: 12px 0; text-decoration: none; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; border-bottom: 1px solid var(--soft-faint); }
  .mobile-menu .wa { margin-top: 12px; text-align: center; border-bottom: 0; }

  @media (max-width: 760px) {
    .bar { grid-template-columns: 1fr auto; padding-block: 18px; }
    .links { display: none; }
    .brand { text-align: left; }
    .menu-btn { display: inline-block; }
  }
  @media (min-width: 761px) { .mobile-menu { display: none; } }
</style>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');

  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  function setOpen(open) {
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'Close' : 'Menu';
    menu.hidden = !open;
    if (open) header?.classList.add('scrolled');
    else onScroll();
  }
  btn?.addEventListener('click', () => setOpen(menu?.hidden ?? true));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
